# The kernel instantiations of the lifted successor generator, one generated translation unit per group of kernels.
#
# The launchers (src/lifted_device.cuh, src/lifted_env.cuh) switch on the object-bitset width OW and the
# forward-checking flag FC and call one function per kernel (gen_warp_case, gen_block_case, deep_case,
# count_keys_case, pick_case); src/lifted_cases.cuh defines them. The kernels with conditional effects and wide rows
# take minutes of nvcc time and gigabytes of memory each (the memory grows with OW), so a unit lists a handful of
# kernels (more of the cheap ones) and the units build in parallel within bounded memory. A kernel that no unit lists
# fails the link; a kernel listed twice fails the configure.
#
# A case is written f<OW> (forward checking, OW 1..4) or p<OW> (plain matcher, OW 1..8, 12, 16, 24, 32). The count and
# write cases name both of their kernels (a warp per segment for launches of few rows, a block kernel otherwise) unless
# they end in w (the warp kernel) or b (the block kernel); multi-instance launches have the block kernel only.
#
# The units of the largest kernels go to the object library mymyr_cuda_lifted_heavy, whose compiles run in the job
# pool cuda_compile_heavy (CMAKE_JOB_POOLS; the pool cuda_compile when that is the only one), the others to
# mymyr_cuda_lifted_units (the pool cuda_compile).

set(_mymyr_lifted_dir ${CMAKE_CURRENT_BINARY_DIR}/lifted_units)
set(_mymyr_lifted_keys "")
set(_mymyr_lifted_light_sources "")
set(_mymyr_lifted_heavy_sources "")
set(_mymyr_lifted_count 0)

# One unit: the file <name>.cu with the instantiations in <body>; <heavy> picks the object library.
function(_mymyr_lifted_emit name heavy body)
    if(body STREQUAL "")
        message(FATAL_ERROR "lifted_units.cmake: the unit ${name} instantiates nothing")
    endif()
    file(GENERATE OUTPUT ${_mymyr_lifted_dir}/${name}.cu
         CONTENT "// Generated by lifted_units.cmake.\n#include \"lifted_cases.cuh\"\n\nnamespace mymyr::cuda::lifted\n{\n${body}}  // namespace mymyr::cuda::lifted\n")
    if(heavy)
        set(_mymyr_lifted_heavy_sources ${_mymyr_lifted_heavy_sources} ${_mymyr_lifted_dir}/${name}.cu PARENT_SCOPE)
    else()
        set(_mymyr_lifted_light_sources ${_mymyr_lifted_light_sources} ${_mymyr_lifted_dir}/${name}.cu PARENT_SCOPE)
    endif()
endfunction()

# The instantiation lines of the case <token> (f<OW> / p<OW>, with an optional kernel suffix) of <family> with the
# template arguments <args> after (OW, FC), appended to <out>; claims the kernels.
function(_mymyr_lifted_lines out family token args)
    string(SUBSTRING ${token} 0 1 fc_char)
    string(REGEX MATCH "^[fp]([0-9]+)([wb]?)$" _ ${token})
    if(NOT CMAKE_MATCH_1 OR NOT (fc_char STREQUAL "f" OR fc_char STREQUAL "p"))
        message(FATAL_ERROR "lifted_units.cmake: bad case ${token}")
    endif()
    set(ow ${CMAKE_MATCH_1})
    set(kind "${CMAKE_MATCH_2}")
    if(fc_char STREQUAL "f")
        set(fc true)
    else()
        set(fc false)
    endif()
    set(lines "")
    if(family STREQUAL "gen")
        # args: Write;WB;CE;M
        list(GET args 0 write)
        list(GET args 1 wb)
        list(GET args 2 ce)
        list(GET args 3 m)
        foreach(k w b)
            if("${kind}" STREQUAL "" OR "${kind}" STREQUAL k)
                if(k STREQUAL "w" AND m STREQUAL "true")
                    if("${kind}" STREQUAL "w")
                        message(FATAL_ERROR "lifted_units.cmake: multi-instance launches have no warp kernel (${token})")
                    endif()
                    continue()
                endif()
                set(key "gen${k} ${write} ${wb} ${ce} ${m} ${fc_char}${ow}")
                if(key IN_LIST _mymyr_lifted_keys)
                    message(FATAL_ERROR "lifted_units.cmake: the kernel ${key} is listed twice")
                endif()
                set(_mymyr_lifted_keys ${_mymyr_lifted_keys} "${key}" PARENT_SCOPE)
                set(_mymyr_lifted_keys ${_mymyr_lifted_keys} "${key}")
                if(k STREQUAL "w")
                    string(APPEND lines "template cudaError_t gen_warp_case<${ow}, ${fc}, ${write}, ${wb}, ${ce}>(const GenArgs&, unsigned, cudaStream_t);\n")
                else()
                    string(APPEND lines "template cudaError_t gen_block_case<${ow}, ${fc}, ${write}, ${wb}, ${ce}, ${m}>(const GenArgs&, unsigned, unsigned, cudaStream_t);\n")
                endif()
            endif()
        endforeach()
    else()
        set(key "${family} ${args} ${fc_char}${ow}")
        if(key IN_LIST _mymyr_lifted_keys)
            message(FATAL_ERROR "lifted_units.cmake: the kernel ${key} is listed twice")
        endif()
        set(_mymyr_lifted_keys ${_mymyr_lifted_keys} "${key}" PARENT_SCOPE)
        if(family STREQUAL "deep")
            # args: Write;WB
            list(GET args 0 write)
            list(GET args 1 wb)
            set(lines "template cudaError_t deep_case<${ow}, ${fc}, ${write}, ${wb}>(const GenArgs&, cudaStream_t);\n")
        elseif(family STREQUAL "keys")
            # args: M
            set(lines "template cudaError_t count_keys_case<${ow}, ${fc}, ${args}>(const GenArgs&, const CountCache&, bool, cudaStream_t);\n")
        elseif(family STREQUAL "pick")
            # args: WB;M
            list(GET args 0 wb)
            list(GET args 1 m)
            set(lines "template cudaError_t pick_case<${ow}, ${fc}, ${wb}, ${m}>(const GenArgs&, const Picks&, cudaStream_t);\n")
        endif()
    endif()
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# mymyr_lifted_units(<name> <family> <args> [HEAVY] PER <n> CASES <case>...): the cases in units of <n> cases each.
# The count / write kernels of a case count as one case (two kernels), so PER counts cases, not kernels.
function(mymyr_lifted_units name family args)
    cmake_parse_arguments(A "HEAVY" "PER" "CASES" ${ARGN})
    set(n 0)
    set(in_unit 0)
    set(body "")
    foreach(token IN LISTS A_CASES)
        _mymyr_lifted_lines(lines ${family} ${token} "${args}")
        string(APPEND body "${lines}")
        math(EXPR in_unit "${in_unit} + 1")
        if(in_unit EQUAL A_PER)
            _mymyr_lifted_emit(${name}_${n} "${A_HEAVY}" "${body}")
            math(EXPR n "${n} + 1")
            set(in_unit 0)
            set(body "")
        endif()
    endforeach()
    if(in_unit GREATER 0)
        _mymyr_lifted_emit(${name}_${n} "${A_HEAVY}" "${body}")
    endif()
    set(_mymyr_lifted_keys ${_mymyr_lifted_keys} PARENT_SCOPE)
    set(_mymyr_lifted_light_sources ${_mymyr_lifted_light_sources} PARENT_SCOPE)
    set(_mymyr_lifted_heavy_sources ${_mymyr_lifted_heavy_sources} PARENT_SCOPE)
endfunction()

# The cases of a launch: forward checking 1..4, plain 1..8, and the wide object bitsets (12..32) where the kernel
# takes them (the count kernels, and the write kernels of rows of 64 words and more).
set(_f f1 f2 f3 f4)
set(_p p1 p2 p3 p4 p5 p6 p7 p8)
set(_pbig p12 p16 p24 p32)

# ---- counts and writes of schemas without conditional effects
mymyr_lifted_units(count gen "false;1;false;false" PER 16 CASES ${_f} ${_p} ${_pbig})
mymyr_lifted_units(count_multi gen "false;1;false;true" PER 16 CASES ${_f} ${_p} ${_pbig})
foreach(wb 2 4 16)
    mymyr_lifted_units(write_${wb} gen "true;${wb};false;false" PER 4 CASES ${_f} ${_p})
    mymyr_lifted_units(write_multi_${wb} gen "true;${wb};false;true" PER 12 CASES ${_f} ${_p})
endforeach()
mymyr_lifted_units(write_64 gen "true;k_max_words;false;false" PER 4 CASES ${_f} ${_p} ${_pbig})
mymyr_lifted_units(write_multi_64 gen "true;k_max_words;false;true" PER 16 CASES ${_f} ${_p} ${_pbig})
mymyr_lifted_units(write_wide gen "true;k_wide;false;false" PER 4 CASES ${_f} ${_p} ${_pbig})
mymyr_lifted_units(write_multi_wide gen "true;k_wide;false;true" PER 16 CASES ${_f} ${_p} ${_pbig})

# ---- conditional effects: the warp kernels grow with OW (about 0.2 GB per word of the object bitset)
foreach(wb 4 16)
    mymyr_lifted_units(write_ce_${wb} gen "true;${wb};true;false" PER 3 CASES ${_f} ${_p})
endforeach()
foreach(wb k_max_words k_wide)
    string(REPLACE "k_" "" tag ${wb})
    mymyr_lifted_units(write_ce_${tag} gen "true;${wb};true;false" PER 3 CASES ${_f} ${_p} p12b p16b p24b p32b)
    mymyr_lifted_units(write_ce_${tag}_warp gen "true;${wb};true;false" PER 2 CASES p12w)
    mymyr_lifted_units(write_ce_${tag}_warp_heavy gen "true;${wb};true;false" HEAVY PER 1 CASES p16w p24w p32w)
endforeach()

# ---- deep matchers
set(_pdeep p1 p2 p3 p4)
foreach(wb 2 4 16 k_max_words k_wide)
    mymyr_lifted_units(deep_${wb} deep "true;${wb}" PER 8 CASES ${_f} ${_pdeep})
endforeach()
mymyr_lifted_units(deep_count deep "false;1" PER 8 CASES ${_f} ${_pdeep})

# ---- count caches and picks
mymyr_lifted_units(count_keys keys "false" PER 16 CASES ${_f} ${_p} ${_pbig})
mymyr_lifted_units(count_keys_multi keys "true" PER 16 CASES ${_f} ${_p} ${_pbig})
foreach(wb 2 4 16)
    mymyr_lifted_units(pick_${wb} pick "${wb};false" PER 12 CASES ${_f} ${_p})
    mymyr_lifted_units(pick_multi_${wb} pick "${wb};true" PER 12 CASES ${_f} ${_p})
endforeach()
foreach(wb k_max_words k_wide)
    mymyr_lifted_units(pick_${wb} pick "${wb};false" PER 16 CASES ${_f} ${_p} ${_pbig})
    mymyr_lifted_units(pick_multi_${wb} pick "${wb};true" PER 16 CASES ${_f} ${_p} ${_pbig})
endforeach()
